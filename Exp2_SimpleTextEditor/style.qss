/* ============================================================
   实验二 简单文本编辑器 —— 全局样式表
   在示例图的布局基础上做现代化处理：浅色卡片、蓝色强调色、
   圆角控件、分组工具栏、清晰的状态栏。
   ============================================================ */

QMainWindow,
QDialog {
    background: #f5f7fb;
    color: #22304a;
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 10pt;
}

/* ---------- 菜单栏 ---------- */
QMenuBar {
    background: #ffffff;
    border-bottom: 1px solid #e3e9f2;
    padding: 2px 4px;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 5px;
    color: #334155;
}
QMenuBar::item:selected {
    background: #e8f0ff;
    color: #1d4ed8;
}
QMenuBar::item:pressed { background: #dbe7ff; }

QMenu {
    background: #ffffff;
    border: 1px solid #dce4f0;
    border-radius: 8px;
    padding: 5px;
}
QMenu::item {
    padding: 6px 30px 6px 26px;
    border-radius: 5px;
    color: #334155;
}
QMenu::item:selected { background: #e8f0ff; color: #1d4ed8; }
QMenu::item:disabled { color: #a9b4c4; }
QMenu::separator {
    height: 1px;
    background: #e8edf5;
    margin: 4px 8px;
}
QMenu::icon { padding-left: 6px; }

/* ---------- 工具栏 ---------- */
QToolBar {
    background: #ffffff;
    border: none;
    border-bottom: 1px solid #e3e9f2;
    padding: 5px 7px;
    spacing: 3px;
}
QToolBar::separator {
    width: 1px;
    background: #dfe6f0;
    margin: 3px 7px;
}
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
    min-width: 28px;
    min-height: 26px;
    color: #334155;
}
QToolButton:hover  { background: #eef4ff; border-color: #d6e4ff; }
QToolButton:pressed{ background: #dce9ff; }
QToolButton:checked{ background: #e0ebff; border-color: #a9c6ff; }
QToolButton:disabled { color: #b6c0cf; background: transparent; }

/* ---------- 编辑区 ---------- */
QPlainTextEdit,
CodeEditor {
    background: #ffffff;
    color: #1f2937;
    border: 1px solid #dfe6f0;
    border-radius: 8px;
    padding: 6px 8px;
    selection-background-color: #b9d3ff;
    selection-color: #102a56;
    font-family: "Cascadia Mono", "Consolas", "Microsoft YaHei UI", monospace;
    font-size: 11pt;
}

/* ---------- 状态栏 ---------- */
QStatusBar {
    background: #eef2f8;
    border-top: 1px solid #e3e9f2;
    color: #475569;
}
QStatusBar QLabel {
    color: #475569;
    padding: 2px 10px;
    border-right: 1px solid #dce4f0;
}
QStatusBar QLabel#lblAuthor { border-right: none; color: #1d4ed8; font-weight: 600; }

/* ---------- 对话框通用控件 ---------- */
QLabel { color: #334155; }
QLineEdit {
    background: #ffffff;
    border: 1px solid #ccd7e6;
    border-radius: 6px;
    padding: 6px 9px;
    selection-background-color: #b9d3ff;
}
QLineEdit:focus { border: 1px solid #4b83f5; }
QPushButton {
    background: #ffffff;
    border: 1px solid #ccd7e6;
    border-radius: 6px;
    padding: 6px 16px;
    color: #334155;
    min-height: 20px;
}
QPushButton:hover   { background: #eef4ff; border-color: #a9c6ff; }
QPushButton:pressed { background: #dce9ff; }
QPushButton:default { background: #2563eb; border-color: #2563eb; color: #ffffff; }
QPushButton:default:hover { background: #1d4ed8; }
QGroupBox {
    border: 1px solid #dce4f0;
    border-radius: 7px;
    margin-top: 12px;
    padding: 8px 10px;
    color: #475569;
}
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 5px; }
QCheckBox, QRadioButton { spacing: 7px; color: #334155; }
QMessageBox { background: #ffffff; }
